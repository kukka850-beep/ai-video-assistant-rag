# Required for AI-powered summaries and chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Required only for Hindi / Hinglish transcription
SARVAM_API_KEY=
# Override if Sarvam changes its public STT endpoint.
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text

# Whisper downloads this model on first run. Use base/small/medium as needed.
WHISPER_MODEL=base
